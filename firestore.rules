rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'alexander.madsen@me.com';
    }
    match /suggestions/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['dish', 'createdAt'])
        && request.resource.data.keys().hasAll(['dish', 'createdAt'])
        && request.resource.data.dish is string
        && request.resource.data.dish.size() > 0
        && request.resource.data.dish.size() <= 80
        && request.resource.data.createdAt is timestamp;
      allow delete: if isAdmin();
      allow update: if false;
    }
    match /contributions/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'dish', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'dish', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.dish is string
        && request.resource.data.dish.size() > 0
        && request.resource.data.dish.size() <= 80
        && request.resource.data.createdAt is timestamp;
      allow delete: if isAdmin();
      allow update: if false;
    }
    match /hiddenSuggestions/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['title', 'createdAt'])
        && request.resource.data.keys().hasAll(['title', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 45
        && request.resource.data.createdAt is timestamp;
      allow delete: if isAdmin();
      allow update: if false;
    }
  }
}
