rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email is string && request.auth.token.email.lower() == 'alexander.madsen@me.com';
    }

    // Faste forslag kan skjules af arrangøren for alle besøgende.
    match /hiddenSuggestions/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /suggestions/{suggestionId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['dish', 'createdAt'])
        && request.resource.data.keys().hasAll(['dish', 'createdAt'])
        && request.resource.data.dish is string
        && request.resource.data.dish.size() > 0
        && request.resource.data.dish.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /contributions/{contributionId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'dish', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.dish is string
        && request.resource.data.dish.size() > 0
        && request.resource.data.dish.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
      allow update: if false;
    }
  }
}
