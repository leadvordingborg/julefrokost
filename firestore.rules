rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'Alexander.madsen@me.com';
    }

    match /contributions/{contributionId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'dish', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.dish is string
        && request.resource.data.dish.size() > 0
        && request.resource.data.dish.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
      allow update: if false;
    }
  }
}
